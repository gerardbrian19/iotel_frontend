rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Password checked, second step not necessarily done. Only for reading/creating your own profile during sign-in.
    function authed() {
      return request.auth != null;
    }

    // Signed in with an authenticator app (TOTP second factor).
    function hasTotp() {
      return request.auth.token.firebase.get('sign_in_second_factor', null) == 'totp';
    }

    // The second sign-in step is done for this session: the emailed code (the `verifyLoginCode` function sets
    // `otpAuthTime` to the session's `auth_time`; a new sign-in changes `auth_time`) or an authenticator app.
    function secondStep() {
      return request.auth.token.get('otpAuthTime', -1) == request.auth.token.auth_time || hasTotp();
    }

    function signedIn() {
      return authed() && secondStep();
    }

    // Staff and admin powers need a session signed in with the authenticator app.
    function isAdmin() {
      return signedIn()
        && hasTotp()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return signedIn()
        && hasTotp()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isStaffOrAdmin() {
      return signedIn()
        && hasTotp()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'];
    }

    // Only call after signedIn() and once the caller's profile is known to exist (errors deny the request).
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function validStock(stock) {
      return stock is int && stock >= 0;
    }

    function validProduct(product) {
      return product.name is string && product.name.size() > 0
        && product.category is string
        && validStock(product.stock)
        && product.get('isActive', true) is bool
        && (product.get('srp', null) == null || (product.srp is number && product.srp >= 0));
    }

    function shortText(value, max) {
      return value is string && value.trim().size() > 0 && value.size() <= max;
    }

    function validAddress(address) {
      return address.keys().hasOnly(['fullName', 'addressLine', 'city', 'province', 'zip', 'mobile', 'isDefault', 'createdAt'])
        && address.keys().hasAll(['fullName', 'addressLine', 'city', 'province', 'zip', 'mobile', 'isDefault', 'createdAt'])
        && shortText(address.fullName, 60)
        && shortText(address.addressLine, 200)
        && shortText(address.city, 80)
        && shortText(address.province, 80)
        && shortText(address.zip, 10)
        && shortText(address.mobile, 20)
        && address.isDefault is bool;
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 60;
    }

    // Profile picture: a small JPEG data URL produced by the client (256x256, roughly 10-40 kB; capped at 150 kB).
    function validPhoto(photo) {
      return photo == null
        || (photo is string && photo.size() <= 150000 && photo.matches('data:image/jpeg;base64,.*'));
    }

    // Which Terms of Service / Privacy Policy versions (legal-documents.ts) the user accepted at sign-up, stamped with
    // the server time. Written once with the profile; the self-update rule below doesn't allow changing it.
    function validLegalAcceptance(acceptance) {
      return acceptance is map
        && acceptance.keys().hasOnly(['termsVersion', 'privacyVersion', 'acceptedAt'])
        && acceptance.keys().hasAll(['termsVersion', 'privacyVersion', 'acceptedAt'])
        && shortText(acceptance.termsVersion, 20)
        && shortText(acceptance.privacyVersion, 20)
        && acceptance.acceptedAt == request.time;
    }

    // One profile per account, keyed by Firebase Auth uid. `role` decides which portal the user can open.
    match /users/{uid} {
      // Read your own profile; admins can read and list everyone's.
      // (`authed()`: the profile, and so the role, is read right after the password, before the second step.)
      allow get: if (authed() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      // Self sign-up (and first sign-in of an account that has no profile): always a customer.
      // (`authed()`: sign-up creates the profile before the emailed-code step.)
      allow create: if authed()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'legalAcceptance'])
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['legalAcceptance'])
          || validLegalAcceptance(request.resource.data.legalAcceptance));

      // Admin-created accounts (staff/admin/customer). The doc id is the new account's uid.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['customer', 'staff', 'admin']
        && request.resource.data.email is string
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;

      // Users may rename themselves and set or clear their profile picture, but never change their role or email.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL'])
        && validName(request.resource.data.name)
        && validPhoto(request.resource.data.get('photoURL', null));

      // Admins change other people's roles (not their own, so the last admin cannot be demoted by accident).
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['customer', 'staff', 'admin'];

      allow delete: if false;
    }

    // A customer's liked products: users/{uid}/favorites/{productId}. Only the owner can see or change them.
    match /users/{uid}/favorites/{productId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A customer's saved shipping addresses: users/{uid}/addresses/{addressId}. Only the owner can see or change them.
    // `isDefault` is kept unique by the client (batched writes); rules only check that each document is well formed.
    match /users/{uid}/addresses/{addressId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validAddress(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validAddress(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // The storefront catalog. Any signed-in user can read it; admins manage it and staff can only adjust stock.
    // NOTE: reads are per document, so every field (including `dealerPrice` if present) is visible to every signed-in customer.
    match /products/{productId} {
      allow read: if signedIn();

      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if (isAdmin() && validProduct(request.resource.data))
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && validStock(request.resource.data.stock));
      allow delete: if isAdmin();
    }

    // A showcased product's public copy: only what the landing page shows (never `dealerPrice`), and only products the
    // document already lists. Mirrors StoredShowcaseProduct in showcase.service.ts.
    function validShowcaseItem(items, i, productIds) {
      return items.size() <= i
        || (items[i] is map
          && items[i].keys().hasOnly(['id', 'name', 'brand', 'category', 'description', 'imageUrl', 'price', 'stock', 'isActive'])
          && items[i].id in productIds
          && (items[i].price == null || (items[i].price is number && items[i].price >= 0))
          && validStock(items[i].stock)
          && items[i].isActive is bool);
    }

    // `showcase/bestSellers` = { productIds, products, updatedAt }: the landing page's Best Sellers, readable without
    // signing in. `npm run sync:showcase` (Admin SDK) creates it and picks the products; staff and admins' clients only
    // refresh the copies when prices or stock change (ShowcaseService).
    match /showcase/{docId} {
      allow get: if docId == 'bestSellers';
      allow list: if false;
      allow create, delete: if false;
      allow update: if isStaffOrAdmin()
        && docId == 'bestSellers'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['products', 'updatedAt'])
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 4
        && validShowcaseItem(request.resource.data.products, 0, resource.data.productIds)
        && validShowcaseItem(request.resource.data.products, 1, resource.data.productIds)
        && validShowcaseItem(request.resource.data.products, 2, resource.data.productIds)
        && validShowcaseItem(request.resource.data.products, 3, resource.data.productIds)
        && request.resource.data.updatedAt == request.time;
    }

    // Bookable services (seeded with `npm run seed:services`). Any signed-in user can read them; admins manage them.
    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && shortText(request.resource.data.title, 100)
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.description is string && request.resource.data.description.size() <= 500;
      allow delete: if isAdmin();
    }

    // One document per taken slot, id = `{date}T{HH:mm}`. It is created and deleted in the same batch as the booking
    // that holds it, and creating an id that already exists counts as an update, which is denied: that is what stops
    // two customers booking the same slot. The document holds no personal data, so everyone can read it to see availability.
    match /bookingSlots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['date', 'time', 'bookingId'])
        && request.resource.data.keys().hasAll(['date', 'time', 'bookingId'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.time in ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00']
        && request.resource.data.bookingId is string
        && slotId == request.resource.data.date + 'T' + request.resource.data.time
        && existsAfter(bookingPath(request.resource.data.bookingId))
        && getAfter(bookingPath(request.resource.data.bookingId)).data.preferredDate == request.resource.data.date
        && getAfter(bookingPath(request.resource.data.bookingId)).data.preferredTime == request.resource.data.time
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status in ['Pending', 'Confirmed', 'Paid']
        && (getAfter(bookingPath(request.resource.data.bookingId)).data.customerId == request.auth.uid || isStaffOrAdmin());

      allow update: if false;

      // Freed when its booking is cancelled (by the customer or staff) or moved to another slot (by staff).
      allow delete: if signedIn()
        && ((getAfter(bookingPath(resource.data.bookingId)).data.status == 'Cancelled'
            && (get(bookingPath(resource.data.bookingId)).data.customerId == request.auth.uid || isStaffOrAdmin()))
          || (isStaffOrAdmin()
            && (getAfter(bookingPath(resource.data.bookingId)).data.preferredDate != resource.data.date
              || getAfter(bookingPath(resource.data.bookingId)).data.preferredTime != resource.data.time)));
    }

    function bookingPaid(booking) {
      return booking.keys().hasAny(['payment']) && booking.payment.status == 'Paid';
    }

    function validQuote(quote) {
      return quote.keys().hasOnly(['amount', 'note', 'quotedAt'])
        && quote.keys().hasAll(['amount', 'note', 'quotedAt'])
        && quote.amount is number && quote.amount > 0
        && quote.note is string && quote.note.size() <= 500
        && quote.quotedAt is timestamp;
    }

    function validNewBooking(booking, bookingId) {
      return booking.keys().hasOnly(['serviceId', 'serviceName', 'servicePrice', 'customerId', 'customerName',
          'customerEmail', 'customerMobile', 'preferredDate', 'preferredTime', 'notes', 'status', 'conversationId',
          'createdAt', 'updatedAt'])
        && booking.keys().hasAll(['serviceId', 'serviceName', 'servicePrice', 'customerId', 'customerName',
          'customerEmail', 'customerMobile', 'preferredDate', 'preferredTime', 'notes', 'status', 'conversationId',
          'createdAt', 'updatedAt'])
        && booking.customerId == request.auth.uid
        && booking.status == 'Pending'
        && shortText(booking.serviceId, 100)
        && shortText(booking.serviceName, 100)
        && booking.servicePrice is number && booking.servicePrice >= 0
        && shortText(booking.customerName, 60)
        && shortText(booking.customerEmail, 100)
        && shortText(booking.customerMobile, 20)
        && booking.preferredDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && booking.preferredTime in ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00']
        && booking.notes is string && booking.notes.size() <= 1000
        && booking.createdAt == request.time
        && booking.updatedAt == request.time
        // The slot and the booking's chat come with it in the same batch.
        && existsAfter(/databases/$(database)/documents/bookingSlots/$(booking.preferredDate + 'T' + booking.preferredTime))
        && getAfter(/databases/$(database)/documents/bookingSlots/$(booking.preferredDate + 'T' + booking.preferredTime)).data.bookingId == bookingId
        && existsAfter(conversationPath(booking.conversationId))
        && getAfter(conversationPath(booking.conversationId)).data.bookingId == bookingId;
    }

    // A service booking. Customers create their own (always Pending) and can cancel it until it is paid; staff and
    // admins see every booking and drive it: quote and confirm, reschedule, complete, cancel an unpaid one.
    // `payment` (PayMongo) is written only by the backend: createBookingCheckout opens it, the webhook marks it Paid
    // together with status 'Paid', and refundPayment refunds and cancels.
    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaffOrAdmin());

      allow create: if signedIn() && validNewBooking(request.resource.data, bookingId);

      allow update: if signedIn() && (
        // Customer cancels, until it is paid.
        (resource.data.customerId == request.auth.uid
          && resource.data.status in ['Pending', 'Confirmed']
          && !bookingPaid(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.updatedAt == request.time)
        // Staff and admins change everything except who booked what and the payment. Only the webhook makes a
        // booking Paid, and a paid booking is cancelled only by refunding it (backend).
        || (isStaffOrAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId', 'customerName',
            'customerEmail', 'customerMobile', 'serviceId', 'serviceName', 'servicePrice', 'conversationId',
            'notes', 'createdAt', 'payment'])
          && request.resource.data.status in ['Pending', 'Confirmed', 'Paid', 'Completed', 'Cancelled']
          && (request.resource.data.status != 'Paid' || resource.data.status == 'Paid')
          && (request.resource.data.status != 'Completed' || resource.data.status in ['Paid', 'Completed'])
          && (request.resource.data.status != 'Cancelled' || resource.data.status == 'Cancelled'
            || !bookingPaid(resource.data))
          && (!request.resource.data.keys().hasAny(['quote']) || validQuote(request.resource.data.quote))
          && request.resource.data.updatedAt == request.time)
      );

      allow delete: if false;
    }

    // A chat thread between a customer and the shop, either opened from a booking or as a general inquiry.
    // `customerUnread` / `staffUnread` are each side's unread counters (the sender bumps the other side's).
    match /conversations/{conversationId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaffOrAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'subject', 'bookingId', 'lastMessage',
          'lastMessageAt', 'customerUnread', 'staffUnread', 'createdAt'])
        && request.resource.data.keys().hasAll(['customerId', 'customerName', 'subject', 'lastMessage',
          'lastMessageAt', 'customerUnread', 'staffUnread', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && shortText(request.resource.data.customerName, 60)
        && shortText(request.resource.data.subject, 120)
        && shortText(request.resource.data.lastMessage, 2000)
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.customerUnread == 0
        && request.resource.data.staffUnread == 1
        && (!request.resource.data.keys().hasAny(['bookingId'])
          || getAfter(bookingPath(request.resource.data.bookingId)).data.customerId == request.auth.uid);

      // Either side moves the preview and the unread counters; nothing else changes.
      allow update: if signedIn()
        && (resource.data.customerId == request.auth.uid || isStaffOrAdmin())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'customerUnread', 'staffUnread'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastMessageAt'])
          || (shortText(request.resource.data.lastMessage, 2000) && request.resource.data.lastMessageAt == request.time))
        && request.resource.data.customerUnread is int && request.resource.data.customerUnread >= 0
        && request.resource.data.staffUnread is int && request.resource.data.staffUnread >= 0;

      allow delete: if false;

      // Messages are append-only. `getAfter` lets the first message be written in the same batch as its conversation.
      match /messages/{messageId} {
        allow read: if signedIn()
          && (get(conversationPath(conversationId)).data.customerId == request.auth.uid || isStaffOrAdmin());

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderRole', 'kind', 'content', 'sentAt'])
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'senderRole', 'kind', 'content', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == userProfile().name
          && request.resource.data.senderRole == userProfile().role
          && request.resource.data.kind in ['text', 'event']
          && shortText(request.resource.data.content, 2000)
          && request.resource.data.sentAt == request.time
          && (getAfter(conversationPath(conversationId)).data.customerId == request.auth.uid || isStaffOrAdmin());

        allow update, delete: if false;
      }
    }

    // ── Orders ─────────────────────────────────────────────────────────────────

    // Pending → Processing (paid) → Shipped → Delivered; an unpaid Pending order → Cancelled. Paid orders are cancelled
    // only by refunding them (the refundPayment function), and the payment never changes here.
    function validStatusChange(before, after) {
      return (before.status == 'Pending'
          && after.status == 'Processing'
          && before.payment.status == 'Paid'
          && after.processedAt == request.time)
        || (before.status == 'Pending'
          && before.payment.status == 'Unpaid'
          && after.status == 'Cancelled'
          && after.cancelledBy == 'staff'
          && after.cancelledAt == request.time
          && (!after.keys().hasAny(['cancelReason']) || shortText(after.cancelReason, 200)))
        || (before.status == 'Processing'
          && after.status == 'Shipped'
          && after.shippedAt == request.time
          && after.shipment.keys().hasOnly(['courier', 'trackingNumber'])
          && shortText(after.shipment.courier, 60)
          && after.shipment.trackingNumber is string
          && after.shipment.trackingNumber.size() <= 60)
        || (before.status == 'Shipped'
          && after.status == 'Delivered'
          && after.deliveredAt == request.time);
    }

    // Staff and admins can never touch who ordered what, the items, the amounts or the payment.
    function validStaffOrderUpdate(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'shipment', 'processedAt', 'shippedAt',
          'deliveredAt', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt'])
        && after.updatedAt == request.time
        && after.status != before.status
        && validStatusChange(before, after);
    }

    // A customer's order. Orders are created only by the createOrderCheckout function (which prices them from the
    // catalog) and paid through PayMongo, whose webhook is the only thing that marks them Paid. Customers can cancel
    // an unpaid pending order; staff and admins see every order and move it along.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaffOrAdmin());

      allow create: if false;

      allow update: if signedIn() && (
        // Customer cancels a pending order that hasn't been paid.
        (resource.data.customerId == request.auth.uid
          && resource.data.status == 'Pending'
          && resource.data.payment.status == 'Unpaid'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt'])
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.cancelledBy == 'customer'
          && request.resource.data.cancelledAt == request.time
          && (!request.resource.data.keys().hasAny(['cancelReason']) || shortText(request.resource.data.cancelReason, 200))
          && request.resource.data.updatedAt == request.time)
        // Staff and admins.
        || (isStaffOrAdmin() && validStaffOrderUpdate(resource.data, request.resource.data))
      );

      allow delete: if false;
    }

    // `counters/orders` = { last }: the number of the latest order, moved up by createOrderCheckout. It holds nothing
    // sensitive beyond how many orders there have been.
    match /counters/{counterId} {
      allow read: if signedIn() && counterId == 'orders';
      allow write: if false;
    }

    // PayMongo webhook events already applied (idempotency), written only by the Cloud Functions.
    match /paymongoEvents/{eventId} {
      allow read, write: if false;
    }

    // Emailed sign-in codes (hashed), written and read only by the Cloud Functions (Admin SDK bypasses rules).
    match /loginCodes/{uid} {
      allow read, write: if false;
    }

    // Everything else stays locked until its feature is migrated to Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
